<div class="ov" id="ov"></div>
<aside class="dr" id="dr" aria-label="Shopping cart">
  <div class="dh"><h3 id="dt">Your Cart</h3><button id="dx" aria-label="Close">✕</button></div>
  <div class="db" id="di"></div>
  <div class="df" id="dfo"></div>
</aside>
<div class="toast" id="ts" role="status"></div>

<script>
var CATS=[["Electronics & Gadgets","🎧"],["Fashion & Clothing","👕"],["Home & Living","🏠"],["Beauty & Personal Care","💄"],["Accessories","👜"],["Fitness & Lifestyle","🧘"]];
var CL=["#E8F0FE","#FDEEE4","#E6F6EF","#F9E8F2","#EEF0F6","#FFF4D9"];
var P=[
["Wireless Bluetooth Headphones",39.99,0,"🎧","Over-ear wireless headphones with soft cushions for long listening sessions."],
["Smart Watch",49.99,0,"⌚","A lightweight watch for notifications, activity tracking and quick time checks."],
["Portable Bluetooth Speaker",29.99,0,"🔊","A compact speaker that carries music from desk to backyard."],
["Wireless Charging Pad",19.99,0,"🔋","Set your compatible phone down to charge without fiddling with cables."],
["LED Desk Lamp",24.99,0,"💡","An adjustable lamp that lights your workspace without harsh glare."],
["USB-C Fast Charging Cable",9.99,0,"🔌","A sturdy cable for quick charging and everyday data transfer."],
["Classic Cotton T-Shirt",19.99,1,"👕","A breathable everyday tee that layers well and washes easily."],
["Casual Hoodie",34.99,1,"🧥","A cosy pullover with a relaxed fit for cooler days."],
["Everyday Backpack",39.99,1,"🎒","Roomy enough for daily essentials, with compartments that keep things tidy."],
["Premium Sunglasses",24.99,1,"🕶️","Stylish frames made for bright commutes and weekend trips."],
["Classic Sports Cap",14.99,1,"🧢","A simple adjustable cap for walks, workouts and sunny errands."],
["Casual Sneakers",59.99,1,"👟","Comfort-first sneakers that pair with jeans, shorts and everything between."],
["Decorative Table Lamp",32.99,2,"🛋️","A warm accent light that adds character to a bedside or living room."],
["Minimalist Wall Clock",21.99,2,"🕒","A clean-faced clock that keeps time and keeps walls uncluttered."],
["Modern Water Bottle",16.99,2,"🥤","A reusable bottle with a sleek profile for home, desk or commute."],
["Soft Decorative Cushion Set",27.99,2,"🛏️","Plush cushions that refresh sofas, beds and reading corners."],
["Kitchen Storage Organizer",18.99,2,"🧺","Sorts pantry and counter items so everything has its place."],
["Premium Bedsheet Set",44.99,2,"🛌","A smooth, breathable set designed for comfortable nights."],
["Facial Cleansing Brush",19.99,3,"🧼","A gentle brush for a more thorough daily cleansing routine."],
["Skincare Organizer",17.99,3,"🧴","Keeps serums, creams and tools neatly within reach."],
["Makeup Brush Set",22.99,3,"💄","A versatile set of soft brushes for everyday and special looks."],
["Travel Toiletry Bag",15.99,3,"🧳","A compact, wipe-clean bag that organises your trip essentials."],
["Minimalist Wallet",24.99,4,"👛","A slim wallet with enough room for cards and cash without bulk."],
["Laptop Sleeve",27.99,4,"💻","A padded sleeve that protects your laptop from scuffs and bumps."],
["Stainless Steel Keychain",8.99,4,"🔑","A durable keychain that keeps keys together and easy to find."],
["Fashion Crossbody Bag",34.99,4,"👝","A hands-free bag sized for phone, wallet and daily must-haves."],
["Yoga Mat",24.99,5,"🧘","A cushioned, non-slip mat for yoga, stretching and floor workouts."],
["Resistance Bands Set",16.99,5,"💪","Portable bands in varied strengths for strength and mobility work."],
["Insulated Sports Bottle",19.99,5,"🥛","An insulated bottle built for the gym, trail or office."],
["Adjustable Skipping Rope",12.99,5,"🪢","A length-adjustable rope for simple, effective cardio anywhere."],
["White Formal Shirt",100,1,"👔","A crisp white button-up with a clean collar, made for school, office and special occasions.",1]
];
var PH=["data:image/jpeg;base64,"];
var FEAT=[30,0,1,8,11,17,26,12];
var $=function(i){return document.getElementById(i)};
var cart=[],wish=[],shown=12;
try{cart=JSON.parse(localStorage.getItem("nc_cart")||"[]");wish=JSON.parse(localStorage.getItem("nc_wish")||"[]")}catch(e){}
function save(){try{localStorage.setItem("nc_cart",JSON.stringify(cart));localStorage.setItem("nc_wish",JSON.stringify(wish))}catch(e){}}
function money(n){return "$"+n.toFixed(2)}
function toast(m){var t=$("ts");t.textContent=m;t.classList.add("on");clearTimeout(toast.t);toast.t=setTimeout(function(){t.classList.remove("on")},1800)}
function card(i){var p=P[i];return '<article class="card"><div class="pi" style="background:'+CL[p[2]]+'">'+(p[5]?'<span class="sale">Sale</span><img src="'+PH[0]+'" alt="'+p[0]+'" loading="lazy">':p[3])+'<button class="wl'+(wish.indexOf(i)>-1?" on":"")+'" data-w="'+i+'" aria-label="Add to wishlist">'+(wish.indexOf(i)>-1?"♥":"♡")+'</button></div><div class="pb"><span class="pc">'+CATS[p[2]][0]+'</span><h3>'+p[0]+'</h3><p>'+p[4]+'</p><div class="pr"><b>'+money(p[1])+'</b><button class="add" data-a="'+i+'">Add to Cart</button></div></div></article>'}
function cats(){$("cats").innerHTML=CATS.map(function(c,i){var n=P.filter(function(p){return p[2]==i}).length;return '<a class="cat" href="#shop" data-c="'+i+'"><span>'+c[1]+'</span><h3>'+c[0]+'</h3><small>'+n+' products</small></a>'}).join("");
$("fc").innerHTML='<option value="all">All categories</option>'+CATS.map(function(c,i){return '<option value="'+i+'">'+c[0]+'</option>'}).join("");
$("fcats").innerHTML=CATS.map(function(c,i){return '<li><a href="#shop" data-c="'+i+'">'+c[0]+'</a></li>'}).join("");
$("feat").innerHTML=FEAT.map(card).join("")}
function list(){var q=$("q").value.trim().toLowerCase(),c=$("fc").value,mn=parseFloat($("mn").value),mx=parseFloat($("mx").value),s=$("so").value;
var r=P.map(function(p,i){return i}).filter(function(i){var p=P[i];return (c=="all"||p[2]==c)&&(!q||(p[0]+" "+p[4]+" "+CATS[p[2]][0]).toLowerCase().indexOf(q)>-1)&&(isNaN(mn)||p[1]>=mn)&&(isNaN(mx)||p[1]<=mx)});
if(s=="lo")r.sort(function(a,b){return P[a][1]-P[b][1]});if(s=="hi")r.sort(function(a,b){return P[b][1]-P[a][1]});if(s=="new")r.reverse();
$("rs").textContent=r.length+" product"+(r.length==1?"":"s");
$("all").innerHTML=r.length?r.slice(0,shown).map(card).join(""):'<p class="empty" style="grid-column:1/-1">No products match. Try a different keyword or widen your price range.</p>';
$("lm").style.display=r.length>shown?"":"none"}
function counts(){$("cc").textContent=cart.reduce(function(a,x){return a+x.q},0);$("wc").textContent=wish.length}
function drawer(){var t=0;counts();
$("di").innerHTML=cart.length?cart.map(function(x){var p=P[x.i];t+=p[1]*x.q;return '<div class="ci"><span class="e">'+p[3]+'</span><div><h4>'+p[0]+'</h4><small>'+money(p[1])+' each</small><div class="q"><button data-m="'+x.i+'" aria-label="Decrease">−</button><span>'+x.q+'</span><button data-p="'+x.i+'" aria-label="Increase">+</button></div></div><div style="text-align:right"><b>'+money(p[1]*x.q)+'</b><br><button class="rm" data-r="'+x.i+'">Remove</button></div></div>'}).join(""):'<p class="empty">Your cart is empty. Add a product to get started.</p>';
$("dfo").innerHTML=cart.length?'<div class="t"><span>Subtotal</span><span>'+money(t)+'</span></div><p>Shipping and final total are calculated at checkout.</p><a class="btn pri" href="#" id="co">Proceed to Checkout</a><button class="btn dark" id="cs" style="margin-top:10px">Continue Shopping</button>':'<button class="btn dark" id="cs" style="width:100%">Continue Shopping</button>';save()}
function open(t){$("dt").textContent=t;$("dr").classList.add("on");$("ov").classList.add("on");drawer()}
function close(){$("dr").classList.remove("on");$("ov").classList.remove("on")}
function setCat(c){$("fc").value=c;shown=12;list()}
document.addEventListener("click",function(e){var t=e.target.closest("[data-a],[data-w],[data-m],[data-p],[data-r],[data-c],#co,#cs");if(!t){if(e.target.closest("nav a"))$("nav").classList.remove("open");return}
var d=t.dataset;
if(d.a!==undefined){var i=+d.a,f=cart.filter(function(x){return x.i==i})[0];f?f.q++:cart.push({i:i,q:1});drawer();toast(P[i][0]+" added to cart")}
else if(d.w!==undefined){var k=+d.w,j=wish.indexOf(k);j>-1?wish.splice(j,1):wish.push(k);save();counts();cats();list();toast(j>-1?"Removed from wishlist":"Saved to wishlist")}
else if(d.m!==undefined){var x=cart.filter(function(y){return y.i==+d.m})[0];x.q--;if(x.q<1)cart=cart.filter(function(y){return y!==x});drawer()}
else if(d.p!==undefined){cart.filter(function(y){return y.i==+d.p})[0].q++;drawer()}
else if(d.r!==undefined){cart=cart.filter(function(y){return y.i!=+d.r});drawer()}
else if(d.c!==undefined){setCat(d.c)}
else if(t.id=="cs"){close()}
else if(t.id=="co"){e.preventDefault();toast("Checkout needs a payment provider and order system connected first")}});
$("cb").onclick=function(){open("Your Cart")};
$("dx").onclick=close;$("ov").onclick=close;
$("bg").onclick=function(){$("nav").classList.toggle("open")};
$("wlb").onclick=function(){if(!wish.length){toast("Your wishlist is empty");return}$("q").value="";$("fc").value="all";shown=30;var r=$("all");list();r.innerHTML=wish.map(card).join("");$("rs").textContent=wish.length+" saved";$("lm").style.display="none";location.hash="shop"};
["q","fc","mn","mx","so"].forEach(function(id){$(id).addEventListener("input",function(){shown=12;list();if(id=="q"&&this.value)location.hash="shop"})});
$("lm").onclick=function(){shown+=12;list()};
$("nf").addEventListener("submit",function(e){e.preventDefault();var v=$("ne").value.trim(),m=$("nlm");
if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)){m.textContent="Enter a valid email address, like name@example.com.";return}
var ep=this.dataset.endpoint;if(!ep){m.textContent="Subscriptions are not connected yet. Add your email provider endpoint to this form.";return}
fetch(ep,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({email:v})}).then(function(r){if(!r.ok)throw 0;m.textContent="Subscribed. Check your inbox to confirm.";$("ne").value=""}).catch(function(){m.textContent="Could not subscribe. Please try again."})});
document.addEventListener("keydown",function(e){if(e.key=="Escape")close()});
$("yr").textContent=new Date().getFullYear();
cats();list();counts();
(function(){var s=document.querySelectorAll(".sd"),d=$("dots"),n=0,t;
s.forEach(function(_,i){var b=document.createElement("button");b.setAttribute("aria-label","Slide "+(i+1));b.onclick=function(){go(i)};d.appendChild(b)});
function go(i){n=(i+s.length)%s.length;s.forEach(function(x,k){x.classList.toggle("on",k==n);d.children[k].classList.toggle("on",k==n)});reset()}
function reset(){clearInterval(t);if(!matchMedia("(prefers-reduced-motion:reduce)").matches)t=setInterval(function(){go(n+1)},4500)}
document.querySelector(".pv").onclick=function(){go(n-1)};document.querySelector(".nx").onclick=function(){go(n+1)};go(0)})();
</script>
</body>
</html>
